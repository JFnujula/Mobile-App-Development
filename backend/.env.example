# Copy to .env and edit. NEVER commit .env.
ENVIRONMENT=development                 # production in deployment
SECRET_KEY=                             # python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=                           # production: Neon/Vercel Postgres connection string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# First admin, created only when the users table is empty. Remove ADMIN_PASSWORD afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

ENABLE_DOCS=true                        # false in production
ENFORCE_HTTPS=false                     # true behind a TLS reverse proxy
ALLOWED_HOSTS=["*"]                     # production: ["your-project.vercel.app"]
CORS_ORIGINS=[]                         # native apps do not need CORS
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOG_LEVEL=INFO
